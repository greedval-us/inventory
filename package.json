{
  "name": "inventory",
  "productName": "Inventory",
  "version": "0.20.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Локальное настольное приложение для инвентаризации.",
  "author": "Inventory",
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/runElectron.mjs --dev",
    "start": "npm run build && node scripts/runElectron.mjs",
    "start:built": "node scripts/runElectron.mjs",
    "build:preload": "vite build --config vite.preload.config.js",
    "build": "npm run build:preload && vite build",
    "test": "node --test tests/main/*.test.js tests/shared/*.test.js",
    "check": "npm test && npm run build",
    "test:desktop": "npm run build && node scripts/checkDesktop.mjs",
    "pack:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --dir",
    "build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis portable",
    "build:win7": "node scripts/legacy/prepareSqlite.mjs && node scripts/legacy/buildMain.mjs && vite build --mode win7 && electron-builder --config electron-builder.win7.cjs --win --ia32",
    "test:win7": "node scripts/legacy/checkWindows.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "electron": "38.8.6",
    "electron-builder": "24.13.3",
    "esbuild": "0.28.2",
    "lucide-vue-next": "0.536.0",
    "pinia": "3.0.3",
    "resedit": "3.1.0",
    "tar": "7.5.21",
    "vite": "7.3.7",
    "vue": "3.5.44",
    "vue-router": "4.5.1"
  },
  "overrides": {
    "app-builder-lib": {
      "tar": "7.5.21"
    },
    "builder-util-runtime": "9.7.0"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  }
}
